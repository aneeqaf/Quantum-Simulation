# Author: George F. Viamontes
#
# This program implements Grover's quantum search algorithm for a
# circuit size of 22 qubits using the density matrix and an oracle
# that marks the last element in the "database." This code was written
# by George F. Viamontes, but the functionality of the circuit is due
# to Lov Grover.

# Start gathering performance statistics
#tic

ckt_size = 22;

# Create an oracle that marks the last element in the "database." The
# oracle uses one ancillary qubit that is flipped to mark the last
# element in the "database." This ancillary qubit is included in
# the circuit size of 22 qubits (21 data qubits and 1 ancillary qubit).
oracle = cu_gate(sigma_x(1), "cccccccccccccccccccccx");
oracle_trans = oracle';

# Construct the gate operators used in a Grover iteration.  H
# can be used instead of hadamard in version 3.1 and higher.
hn = hadamard(ckt_size);
hn_trans = hn';
hni = kron(hadamard(ckt_size - 1), identity(1));
hni_trans = hni';
cps_op = kron(cps(ckt_size - 1), identity(1));
cps_op_trans = cps_op';

# Create the initial state of the qubits as a density matrix
# initialized as |0^(21)1><0^(21)1|
q0 = cb("0");
q1 = cb("1");
density_matrix = 1;
i = 1;
while (i <= ckt_size - 1)
  density_matrix = kron(density_matrix, q0);
  i = i + 1;
end
density_matrix = kron(density_matrix, q1);
density_matrix = density_matrix*density_matrix';

# Put the qubits into an equal superposition
density_matrix = hn*density_matrix*hn_trans;

# Set-up the number of Grover iterations. Ref: Boyer et
# al. quant-ph/9605034
N = 2^(ckt_size - 1);
M = 1;
x = sqrt(M/N);
# Use the fact that asin(x) = atan(x/sqrt(1 - x^2)) for -1 < x < 1
theta = atan(x/sqrt(1 - x^2));
echo("Number of Grover iterations needed to measure with optimal probability:")
grov_iters = pi/4/theta

echo("Computing the Grover iterations may take a few minutes...")
# Perform the Grover iterations
grov_count = 1;

# Construct a single operator for the Grover iteration
# which applies the oracle, followed by Hadamard operators
# on all qubits except the ancillary qubit, followed by
# the conditional phase shift operator, followed by
# Hadamard operators on all qubits except the ancillary qubit
tic
op = hni*cps_op*hni*oracle;
op_trans = oracle'*hni'*cps_op'*hni';

while (grov_count <= grov_iters)
  density_matrix = op*density_matrix*op_trans;
  grov_count = grov_count + 1;
end

density_matrix = kron(identity(ckt_size - 1), hadamard(1))*density_matrix*kron(identity(ckt_size - 1), hadamard(1));
echo("Grover iterations complete!")
toc

# Perform probabilistic measurement on all qubits.  The result for each
# qubit should be 1 almost all the time
echo("Measuring all qubits probabilistically (they should each evaluate")
echo(" to 1 most of the time)...")
qubit_num = 1;
okay = 1;
while (qubit_num < ckt_size)
  if (pmeasure(qubit_num, density_matrix) ~= 1)
    echo("An erroneous 0 was measured")
    okay = 0;
  end
  qubit_num = qubit_num + 1;
end

if (okay)
  echo("Each data qubit was measured as a 1")
end

# Output performance statistics
toc

# If you would like to try smaller circuit sizes by decreasing
# the value of ckt_size, feel free to uncomment which outputs
# the density matrix to the screen after deterministic measurement
# to verify that this script works correctly.
