# Author: George F. Viamontes
#
# This code demonstrates a simple application of the two-qubit canonical
# decomposition (see Childs, Haselgrove, and Nielsen, Phys. Rev. A 68, 
# 052311, 2003). 

# Set the theta parameters to arbitrary values given the constraint
# that pi/4 >= theta_x >= theta_y >= |theta_z|
theta_x = 0.702;
theta_y = 0.54;
theta_z = 0.2346;

# Set the 1-qubit matrices A1, A2, B1, B2
A1 = hadamard(1);
A2 = sigma_x(1);
B1 = identity(1);
B2 = sigma_y(1);

# Compute U given the canonical decomposition parameters that were
# just set
Xpart = theta_x*kron(sigma_x(1), sigma_x(1));
Ypart = theta_y*kron(sigma_y(1), sigma_y(1));
Zpart = theta_z*kron(sigma_z(1), sigma_z(1));
U = kron(A1, B1)*expm(i*(Xpart + Ypart + Zpart))*kron(A2, B2)
# Apply this gate to the qubits in the density matrix state |10><10|
echo("U applied to density matrix model of state: U|10><10|U'")
state = [0; 0; 1; 0]*[0 0 1 0];
final_state = U*state*U'

# Perform deterministic measurement on both qubits
q_index = 1;
while (q_index < 3)
final_state = measure(q_index, final_state);
q_index = q_index + 1;
end
echo("The state after deterministic measurement:")
measured_state = final_state

# Alternatively, the gate can also be applied to the state vector
# representation of the state if that model is preferred
echo("U applied to state vector model of state: U|10>")
state = [0; 0; 1; 0];
final_state_v = U*state

# Perform deterministic measurement on both qubits
echo("The probability of measuring qubit 1 as a 0:")
p0_qubit1 = measure_sv0(1, final_state_v)
echo("The probability of measuring qubit 1 as a 1:")
p1_qubit1 = measure_sv1(1, final_state_v)
echo("The probability of measuring qubit 2 as a 0:")
p0_qubit2 = measure_sv0(2, final_state_v)
echo("The probability of measuring qubit 2 as a 1:")
p1_qubit2 = measure_sv1(2, final_state_v)
