# Authors: Andrew Lane and Paul E. Black
# Converted by: George F. Viamontes
#
# This circuit implements the NIST benchmark for the Steane 7-qubit
# code which encodes a single logical qubit using 7 qubits and
# corrects phase-flip (Z) errors. This QuIDDPro script was written by
# George F. Viamontes, but the functional design of this circuit is
# courtesy of Andrew Lane and Paul E. Black of NIST. Many of the lines
# of code here are preceded by comments containing the original QHDL
# code written by Andrew Lane and Paul Black. Compare performance
# results with another quantum circuit simulator.

# This circuit contains 13 total qubits. The qubits are listed as follows
# along with their position in the overall circuit (i.e. the position
# number is the wire on which the qubit would appear in a graphical
# depiction of the circuit when read from top to bottom). The
# names of the qubits are arbitrary for the purposes of QuIDDPro,
# but they are needed in the original QHDL NIST circuit description.

# 7 encoding qubits:
# qubit_0  (qubit #1 in the circuit)
# qubit_1  (qubit #2 in the circuit)
# qubit_2  (qubit #3 in the circuit)
# qubit_3  (qubit #4 in the circuit)
# qubit_4  (qubit #5 in the circuit)
# qubit_5  (qubit #6 in the circuit)
# init_state  (qubit #7 in the circuit)

# 3 ancillary qubits for syndrome checking:
# anc  (qubit #8 in the circuit)
# anc2  (qubit #9 in the circuit)
# anc3  (qubit #10 in the circuit)

# 2 ancillary qubits for to help determine the appropriate action
# given the values of the 3 syndrome ancillary qubits:
# all1s_or_all0s  (qubit #11 in the circuit)
# shouldcopZ  (qubit #12 in the circuit)

# 1 qubit to trac the error rate:
# dup  (qubit #13)

# Start gathering performance statistics
tic

# Initialize the 13-qubit state density matrix to the mixed state:
# (0.866025|0000000000000> + 0.5|0000001000000>)*(<0000000000000|0.866025 + <0000001000000|0.5)'
q0 = [1; 0];
q1 = [0; 1];
lhs = q0;
rhs = q0;
i = 1;
while (i < 13)
  lhs = kron(lhs, q0);
  if (i == 6)
    rhs = kron(rhs, q1);
  else
    rhs = kron(rhs, q0);
  end
  i = i + 1;
end
lhs = 0.866025*lhs;
rhs = 0.5*rhs;
density_matrix = lhs + rhs;
# Compute outer product to go from the state vector to the density matrix
density_matrix = density_matrix*density_matrix';

# Save the initial state to compute error rate
curr_gate = cu_gate(sigma_x(1), "iiiiiiciiiiix");
density_matrix = curr_gate*density_matrix*curr_gate';

# First encode one logical qubit with 7 actual qubits

# hadamard(qubit_0); hadamard(qubit_1); hadamard(qubit_2);
# H can be used instead of hadamard in version 3.1 and higher
curr_gate = cu_gate(hadamard(1), "xxxiiiiiiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(init_state, qubit_5); cnot(init_state, qubit_4);
curr_gate = cu_gate(sigma_x(1), "iiiixxciiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_0, qubit_3); cnot(qubit_0, qubit_5); cnot(qubit_0, init_state);
curr_gate = cu_gate(sigma_x(1), "ciixixxiiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_1, qubit_3); cnot(qubit_1, qubit_4); cnot(qubit_1, init_state);
curr_gate = cu_gate(sigma_x(1), "icixxixiiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_2, qubit_3); cnot(qubit_2, qubit_4); cnot(qubit_2, qubit_5);
curr_gate = cu_gate(sigma_x(1), "iicxxxiiiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# Simulate the probability of phase flip on all encoded qubits
i = 1;
while (i < 8)
  density_matrix = pz(0.001, i, density_matrix);
  i = i + 1;
end

# Now rotate the basis

# hadamard(qubit_0); hadamard(qubit_1); hadamard(qubit_2);
# hadamard(qubit_3); hadamard(qubit_4); hadamard(qubit_5);
# hadamard(init_state);
H_rotate = cu_gate(hadamard(1), "xxxxxxxiiiiii");
density_matrix = H_rotate*density_matrix*H_rotate';

# Apply the parity check matrix to the current state and measure the
# resulting 3 ancilla qubits

# cnot(qubit_0, anc);
curr_gate = cu_gate(sigma_x(1), "ciiiiiixiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_3, anc);
curr_gate = cu_gate(sigma_x(1), "iiiciiixiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_5, anc);
curr_gate = cu_gate(sigma_x(1), "iiiiicixiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(init_state, anc);
curr_gate = cu_gate(sigma_x(1), "iiiiiicxiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_1, anc2);
curr_gate = cu_gate(sigma_x(1), "iciiiiiixiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_3, anc2);
curr_gate = cu_gate(sigma_x(1), "iiiciiiixiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_4, anc2);
curr_gate = cu_gate(sigma_x(1), "iiiiciiixiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(init_state, anc2);
curr_gate = cu_gate(sigma_x(1), "iiiiiicixiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_2, anc3);
curr_gate = cu_gate(sigma_x(1), "iiciiiiiixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_3, anc3);
curr_gate = cu_gate(sigma_x(1), "iiiciiiiixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_4, anc3);
curr_gate = cu_gate(sigma_x(1), "iiiiciiiixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_5, anc3);
curr_gate = cu_gate(sigma_x(1), "iiiiiciiixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# Measure the ancilla qubits
i = 8;
while (i < 11)
  density_matrix = measure(i, density_matrix);
  i = i + 1;
end

# For this Hamming code, the syndrome for the first seven qubits
# being flipped is "100" in the 3 ancillary bits.  So flip the last
# two and check for all 3 ancillary bits being 1.  If so, we flip
# the first qubit

# opX(anc2); opX(anc3); opX(all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiixxxii");
density_matrix = curr_gate*density_matrix*curr_gate';

# Store the following three Toffoli and CNOT gates for later
# use (and current use of course!)

# toffoli(anc, anc3, all1s_or_all0s);
toff12 = cu_gate(sigma_x(1), "iiiiiiiccixii");
density_matrix = toff12*density_matrix*toff12';

# toffoli(anc, anc3, all1s_or_all0s);
toff13 = cu_gate(sigma_x(1), "iiiiiiicicxii");
density_matrix = toff13*density_matrix*toff13';

# toffoli(anc2, anc3, all1s_or_all0s);
toff23 = cu_gate(sigma_x(1), "iiiiiiiiccxii");
density_matrix = toff23*density_matrix*toff23';

# cnot(anc, all1s_or_all0s);
cnot1 = cu_gate(sigma_x(1), "iiiiiiiciixii");
density_matrix = cnot1*density_matrix*cnot1';

# cnot(anc2, all1s_or_all0s);
cnot2 = cu_gate(sigma_x(1), "iiiiiiiicixii");
density_matrix = cnot2*density_matrix*cnot2';

# cnot(anc3, all1s_or_all0s);
cnot3 = cu_gate(sigma_x(1), "iiiiiiiiicxii");
density_matrix = cnot3*density_matrix*cnot3';

# toffoli(anc3, all1s_or_all0s, shouldcopZ);
Z_toff1 = cu_gate(sigma_x(1), "iiiiiiiiiccxi");
density_matrix = Z_toff1*density_matrix*Z_toff1';

# copZ(shouldcopZ, qubit_0);
curr_gate = cu_gate(sigma_z(1), "xiiiiiiiiiici");
density_matrix = curr_gate*density_matrix*curr_gate';

# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';

# genAmpDamp(1, 0, all1s_or_all0s);
density_matrix = gen_amp_damp(1, 0, 11, density_matrix);

# opX(anc2); opX(anc3); opX(anc); opX(anc3)
curr_gate = cu_gate(sigma_x(1), "iiiiiiixxiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "010" in the 3 ancillary bits.  So flip the first
# and last and check for all 3 ancillary bits being 1.  If so, we
# flip the second qubit

# Re-use the Toffoli and CNOT gates from the last Hamming run

# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';

# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';

# copZ(shouldcopZ, qubit_1)
curr_gate = cu_gate(sigma_z(1), "ixiiiiiiiiici");
density_matrix = curr_gate*density_matrix*curr_gate';

# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';

# genAmpDamp(1, 0, all1s_or_all0s);
density_matrix = gen_amp_damp(1, 0, 11, density_matrix);

# opX(anc); opX(anc3); opX(anc); opX(anc2);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiixxiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "001" in the 3 ancillary bits.  So flip the first
# and second and check for all 3 ancillary bits being 1.  If so, we
# flip the third qubit

# Re-use the Toffoli and CNOT gates from the first Hamming run

# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';

# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';

# copZ(shouldcopZ, qubit_2);
curr_gate = cu_gate(sigma_z(1), "iixiiiiiiiici");
density_matrix = curr_gate*density_matrix*curr_gate';

# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';

# genAmpDamp(1, 0, all1s_or_all0s);
density_matrix = gen_amp_damp(1, 0, 11, density_matrix);

# opX(anc); opX(anc2);
X_anc_anc2 = cu_gate(sigma_x(1), "iiiiiiixxiiii");
density_matrix = X_anc_anc2*density_matrix*X_anc_anc2';

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "111" in the 3 ancillary bits.  So we check for
# all 3 ancillary bits being 1.  If so, we flip the fourth qubit

# Re-use the Toffoli and CNOT gates from the first Hamming run

# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';
                                                                                
# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';

# copZ(shouldcopZ, qubit_3);
curr_gate = cu_gate(sigma_z(1), "iiixiiiiiiici");
density_matrix = curr_gate*density_matrix*curr_gate';

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "011" in the 3 ancillary bits.  So we
# check for all 3 ancillary bits being 1.  If so, we flip the
# fifth qubit

# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';

# opX(anc)
curr_gate = cu_gate(sigma_x(1), "iiiiiiixiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# Re-use the Toffoli and CNOT gates from the first Hamming run

# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';
                                                                                
# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';
                                                                                
# copZ(shouldcopZ, qubit_4);
curr_gate = cu_gate(sigma_z(1), "iiiixiiiiiici");
density_matrix = curr_gate*density_matrix*curr_gate';

# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';

density_matrix = gen_amp_damp(1, 0, 11, density_matrix);

# opX(anc); opX(anc2);
density_matrix = X_anc_anc2*density_matrix*X_anc_anc2';

# For this Hamming code, the syndrome for the first seven qubits
# being flipped is "101" in the 3 ancillary bits.  So flip the 
# second and check for all 3 ancillary bits being 1.  If so, we
# flip the sixth qubit

# Re-use the Toffoli and CNOT gates from the first Hamming run
                                                                                
# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';
                                                                                
# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';
                                                                                
# copZ(shouldcopZ, qubit_5);
curr_gate = cu_gate(sigma_z(1), "iiiiixiiiiici");
density_matrix = curr_gate*density_matrix*curr_gate';
                                                                                
# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';

# genAmpDamp(1, 0, all1s_or_all0s);
density_matrix = gen_amp_damp(1, 0, 11, density_matrix);

# opX(anc2); opX(anc3);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiixxiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "110" in the 3 ancillary bits.  So flip the last
# and check for all 3 ancillary bits being 1.  If so, we flip the
# seventh qubit

# Re-use the Toffoli and CNOT gates from the first Hamming run
                                                                                
# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';
                                                                                
# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';
                                                                                
# copZ(shouldcopZ, init_state);
curr_gate = cu_gate(sigma_z(1), "iiiiiixiiiici");
density_matrix = curr_gate*density_matrix*curr_gate';
                                                                                
# toffoli(anc3, all1s_or_all0s, shouldcopZ);
density_matrix = Z_toff1*density_matrix*Z_toff1';

# genAmpDamp(1, 0, all1s_or_all0s);
density_matrix = gen_amp_damp(1, 0, 11, density_matrix);

# opX(anc3);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiiixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# Now rotate the basis back

# hadamard(qubit_0); hadamard(qubit_1); hadamard(qubit_2);
# hadamard(qubit_3); hadamard(qubit_4); hadamard(qubit_5);
# hadamard(init_state);
density_matrix = H_rotate*density_matrix*H_rotate';

# We now decode the state and make sure it's what we started with...
# cnot(qubit_4, all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiciiiiixii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_5, all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiciiiixii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(init_state, all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiiciiixii");
density_matrix = curr_gate*density_matrix*curr_gate';

# measure(all1s_or_all0s);
density_matrix = measure(11, density_matrix);

# Determine the error rate

# cnot(all1s_or_all0s, dup);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiiiicix");
density_matrix = curr_gate*density_matrix*curr_gate';

# Trace over everything but the error rate qubit
i = 1;
while (i < 13)
  density_matrix = ptrace(1, density_matrix);
  i = i + 1;
end

# Final output
echo("Value of error rate qubit:")
density_matrix

# Output performance statistics
toc
