# Authors: Andrew Lane and Paul E. Black
# Converted by: George F. Viamontes
#
# This circuit implements the NIST benchmark for the Steane 7-qubit
# code which encodes a single logical qubit using 7 qubits and
# corrects bit-flip (X) errors in a mixed state density matrix. This
# QuIDDPro script is written by George F. Viamontes, but the
# functional design of this circuit is courtesy of Andrew Lane and
# Paul E. Black of NIST. Many of the lines of code here are preceded
# by comments containing the original QHDL code written by Andrew Lane
# and Paul Black. Compare performance results with another quantum
# circuit simulator.

# This circuit contains 12 total qubits. The qubits are listed as follows
# along with their position in the overall circuit (i.e. the position
# number is the wire on which the qubit would appear in a graphical
# depiction of the circuit when read from top to bottom). The
# names of the qubits are arbitrary for the purposes of QuIDDPro,
# but they are needed in the original QHDL NIST circuit description.

# 7 encoding qubits:
# qubit_0  (qubit #1 in the circuit)
# qubit_1  (qubit #2 in the circuit)
# qubit_2  (qubit #3 in the circuit)
# qubit_3  (qubit #4 in the circuit)
# qubit_4  (qubit #5 in the circuit)
# qubit_5  (qubit #6 in the circuit)
# init_state  (qubit #7 in the circuit)

# 3 ancillary qubits for syndrome checking:
# anc  (qubit #8 in the circuit)
# anc2  (qubit #9 in the circuit)
# anc3  (qubit #10 in the circuit)

# 1 ancillary qubit to help determine the appropriate action
# given the values of the 3 syndrome ancillary qubits:
# all1s_or_all0s  (qubit #11 in the circuit)

# 1 qubit to trac the error rate:
# dup  (qubit #12)

# Start gathering performance statistics
tic

# Initialize the 12-qubit state density matrix to the mixed state:
# (0.866025|000000000000> + 0.5|000000100000>)*(<000000000000|0.866025 + <000000100000|0.5)'
q0 = [1; 0];
q1 = [0; 1];
lhs = q0;
rhs = q0;
i = 1;
while (i < 12)
  lhs = kron(lhs, q0);
  if (i == 6)
    rhs = kron(rhs, q1);
  else
    rhs = kron(rhs, q0);
  end
  i = i + 1;
end
lhs = 0.866025*lhs;
rhs = 0.5*rhs;
density_matrix = lhs + rhs;
# Compute outer product to go from the state vector to the density matrix
density_matrix = density_matrix*density_matrix';

# Save the initial state to compute error rate
curr_gate = cu_gate(sigma_x(1), "iiiiiiciiiix");
density_matrix = curr_gate*density_matrix*curr_gate';

# First encode one logical qubit with 7 actual qubits

# hadamard(qubit_0); hadamard(qubit_1); hadamard(qubit_2);
# H can be used instead of hadamard in version 3.1 and higher.
curr_gate = cu_gate(hadamard(1), "xxxiiiiiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(init_state, qubit_5); cnot(init_state, qubit_4);
curr_gate = cu_gate(sigma_x(1), "iiiixxciiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_0, qubit_3); cnot(qubit_0, qubit_5); cnot(qubit_0, init_state);
curr_gate = cu_gate(sigma_x(1), "ciixixxiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_1, qubit_3); cnot(qubit_1, qubit_4); cnot(qubit_1, init_state);
curr_gate = cu_gate(sigma_x(1), "icixxixiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_2, qubit_3); cnot(qubit_2, qubit_4); cnot(qubit_2, qubit_5);
curr_gate = cu_gate(sigma_x(1), "iicxxxiiiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# Simulate the probability of a bit flip on all encoded qubits
i = 1;
while (i < 8)
  density_matrix = px(0.001, i, density_matrix);
  i = i + 1;
end

# Apply the parity check matrix to the current state and measure
# the resulting 3 ancilla qubits

# cnot(qubit_0, anc);
curr_gate = cu_gate(sigma_x(1), "ciiiiiixiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_3, anc);
curr_gate = cu_gate(sigma_x(1), "iiiciiixiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_5, anc);
curr_gate = cu_gate(sigma_x(1), "iiiiicixiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(init_state, anc);
curr_gate = cu_gate(sigma_x(1), "iiiiiicxiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_1, anc2);
curr_gate = cu_gate(sigma_x(1), "iciiiiiixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_3, anc2);
curr_gate = cu_gate(sigma_x(1), "iiiciiiixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_4, anc2);
curr_gate = cu_gate(sigma_x(1), "iiiiciiixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(init_state, anc2);
curr_gate = cu_gate(sigma_x(1), "iiiiiicixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_2, anc3);
curr_gate = cu_gate(sigma_x(1), "iiciiiiiixii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_3, anc3);
curr_gate = cu_gate(sigma_x(1), "iiiciiiiixii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_4, anc3);
curr_gate = cu_gate(sigma_x(1), "iiiiciiiixii");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_5, anc3);
curr_gate = cu_gate(sigma_x(1), "iiiiiciiixii");
density_matrix = curr_gate*density_matrix*curr_gate';

# Measure the ancilla qubits
i = 8;
while (i < 11)
  density_matrix = measure(i, density_matrix);
  i = i + 1;
end

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "100" in the 3 ancillary bits.  So flip the last
# two and check for all 3 ancillary bits being 1.  If so, we flip the
# first qubit

# opX(anc2); opX(anc3); opX(all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiixxxi");
density_matrix = curr_gate*density_matrix*curr_gate';

# Store the following three Toffoli and CNOT gates for later use (and
# current use of course!)

# toffoli(anc, anc2, all1s_or_all0s);
toff12 = cu_gate(sigma_x(1), "iiiiiiiccixi");
density_matrix = toff12*density_matrix*toff12';

# toffoli(anc, anc3, all1s_or_all0s);
toff13 = cu_gate(sigma_x(1), "iiiiiiicicxi");
density_matrix = toff13*density_matrix*toff13';

# toffoli(anc2, anc3, all1s_or_all0s);
toff23 = cu_gate(sigma_x(1), "iiiiiiiiccxi");
density_matrix = toff23*density_matrix*toff23';

# cnot(anc, all1s_or_all0s);
cnot1 = cu_gate(sigma_x(1), "iiiiiiiciixi");
density_matrix = cnot1*density_matrix*cnot1';

# cnot(anc2, all1s_or_all0s);
cnot2 = cu_gate(sigma_x(1), "iiiiiiiicixi");
density_matrix = cnot2*density_matrix*cnot2';

# cnot(anc3, all1s_or_all0s);
cnot3 = cu_gate(sigma_x(1), "iiiiiiiiicxi");
density_matrix = cnot3*density_matrix*cnot3';

# toffoli(anc3, all1s_or_all0s, qubit_0);
curr_gate = cu_gate(sigma_x(1), "xiiiiiiiicci");
density_matrix = curr_gate*density_matrix*curr_gate';

# genAmpDamp(1,1,all1s_or_all0s);
density_matrix = gen_amp_damp(1, 1, 11, density_matrix);

# opX(anc2);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "010" in the 3 ancillary bits.  So flip the first
# and last and check for all 3 ancillary bits being 1.  If so, we flip
# the second qubit

# opX(anc); opX(all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiiixiixi");
density_matrix = curr_gate*density_matrix*curr_gate';

# Re-use the Toffoli and CNOT gates from the last Hamming run

# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';

# toffoli(anc3, all1s_or_all0s, qubit_1);
curr_gate = cu_gate(sigma_x(1), "ixiiiiiiicci");
density_matrix = curr_gate*density_matrix*curr_gate';

# genAmpDamp(1,1,all1s_or_all0s);
density_matrix = gen_amp_damp(1, 1, 11, density_matrix);

# opX(anc3);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiiixii");
density_matrix = curr_gate*density_matrix*curr_gate';

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "001" in the 3 ancillary bits.  So flip the first
# and second and check for all 3 ancillary bits being 1.  If so, we
# flip the third qubit

# opX(anc2); opX(all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiixixi");
density_matrix = curr_gate*density_matrix*curr_gate';

# Re-use the Toffoli and CNOT gates from the last Hamming run

# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';

# toffoli(anc3, all1s_or_all0s, qubit_2);
curr_gate = cu_gate(sigma_x(1), "iixiiiiiicci");
density_matrix = curr_gate*density_matrix*curr_gate';

# genAmpDamp(1,1,all1s_or_all0s);
density_matrix = gen_amp_damp(1, 1, 11, density_matrix);

# opX(anc); opX(anc2);
curr_gate = cu_gate(sigma_x(1), "iiiiiiixxiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "111" in the 3 ancillary bits.  So we check for all
# 3 ancillary bits being 1.  If so, we flip the fourth qubit

# opX(all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiiiixi");
density_matrix = curr_gate*density_matrix*curr_gate';

# Re-use the Toffoli and CNOT gates from the last Hamming run

# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';

# toffoli(anc3, all1s_or_all0s, qubit_3);
curr_gate = cu_gate(sigma_x(1), "iiixiiiiicci");
density_matrix = curr_gate*density_matrix*curr_gate';

# genAmpDamp(1,1,all1s_or_all0s);
density_matrix = gen_amp_damp(1, 1, 11, density_matrix);

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "011" in the 3 ancillary bits.  So flip the first
# check for all 3 ancillary bits being 1.  If so, we flip the fifth
# qubit

# opX(anc); opX(all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiiixiixi");
density_matrix = curr_gate*density_matrix*curr_gate';

# Re-use the Toffoli and CNOT gates from the last Hamming run

# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';

# toffoli(anc3, all1s_or_all0s, qubit_4);
curr_gate = cu_gate(sigma_x(1), "iiiixiiiicci");
density_matrix = curr_gate*density_matrix*curr_gate';

# genAmpDamp(1,1,all1s_or_all0s);
density_matrix = gen_amp_damp(1, 1, 11, density_matrix);

# opX(anc);
curr_gate = cu_gate(sigma_x(1), "iiiiiiixiiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "101" in the 3 ancillary bits.  So flip the second
# and check for all 3 ancillary bits being 1.  If so, we flip the
# sixth qubit

# opX(anc2); opX(all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiixixi");
density_matrix = curr_gate*density_matrix*curr_gate';

# Re-use the Toffoli and CNOT gates from the last Hamming run

# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';

# toffoli(anc3, all1s_or_all0s, qubit_5);
curr_gate = cu_gate(sigma_x(1), "iiiiixiiicci");
density_matrix = curr_gate*density_matrix*curr_gate';

# genAmpDamp(1,1,all1s_or_all0s);
density_matrix = gen_amp_damp(1, 1, 11, density_matrix);

# opX(anc2);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiixiii");
density_matrix = curr_gate*density_matrix*curr_gate';

# For this Hamming code, the syndrome for the first of seven qubits
# being flipped is "110" in the 3 ancillary bits.  So flip the last
# and check for all 3 ancillary bits being 1.  If so, we flip the
# seventh qubit

# opX(anc3); opX(all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiiixxi");
density_matrix = curr_gate*density_matrix*curr_gate';

# Re-use the Toffoli and CNOT gates from the last Hamming run

# toffoli(anc, anc2, all1s_or_all0s); toffoli(anc, anc3,
#  all1s_or_all0s); toffoli(anc2, anc3, all1s_or_all0s); cnot(anc,
#  all1s_or_all0s); cnot(anc2, all1s_or_all0s); cnot(anc3,
#  all1s_or_all0s);
density_matrix = toff12*density_matrix*toff12';
density_matrix = toff13*density_matrix*toff13';
density_matrix = toff23*density_matrix*toff23';
density_matrix = cnot1*density_matrix*cnot1';
density_matrix = cnot2*density_matrix*cnot2';
density_matrix = cnot3*density_matrix*cnot3';

# toffoli(anc3, all1s_or_all0s, init_state);
curr_gate = cu_gate(sigma_x(1), "iiiiiixiicci");
density_matrix = curr_gate*density_matrix*curr_gate';

# genAmpDamp(1,1,all1s_or_all0s);
density_matrix = gen_amp_damp(1, 1, 11, density_matrix);

# opX(anc3);
curr_gate = cu_gate(sigma_x(1), "iiiiiiiiixii");
density_matrix = curr_gate*density_matrix*curr_gate';

# We now decode the state and make sure it's what we started with
# cnot(qubit_4, all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiciiiiixi");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(qubit_5, all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiciiiixi");
density_matrix = curr_gate*density_matrix*curr_gate';

# cnot(init_state, all1s_or_all0s);
curr_gate = cu_gate(sigma_x(1), "iiiiiiciiixi");
density_matrix = curr_gate*density_matrix*curr_gate';

# measure(all1s_or_all0s);
density_matrix = measure(11, density_matrix);

# Determine the error rate
 
# cnot(all1s_or_all0s, dup);	
curr_gate = cu_gate(sigma_x(1), "iiiiiiiiiicx");
density_matrix = curr_gate*density_matrix*curr_gate';

# Trace over everything but the error rate qubit
i = 1;
while (i < 12)
  density_matrix = ptrace(1, density_matrix);
  i = i + 1;
end

# Final output
echo("Value of error rate qubit:")
density_matrix

# Output performance statistics
toc
