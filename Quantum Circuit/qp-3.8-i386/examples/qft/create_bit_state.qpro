function sv = create_bit_state(val, n_bits)
  val_bits = round(log(val)/log(2)) + 1;
  if (val_bits > n_bits)
    val_bits = n_bits;
  end
  
  # Add the first bit (MSB).
  if (val{1} == 1)
    sv = |1:>;
  else
    sv = |0:>;
  end

  # Add the rest of the bits to represent val.
  bits_added = 1;
  while (bits_added < val_bits)
    if (val{bits_added + 1} == 1)
      sv = sv (X) |1:>;
    else
      sv = sv (X) |0:>;
    end
    
    bits_added++;
  end

  # Pad |0>'s to make the bit size equal to n_bits.
  while (bits_added < n_bits)
    sv = sv (X) |0:>;
    bits_added++;
  end
