# Creates an equal superposition with phase changes on the even
# qubits conditional on the odd qubits.
function |eeo:> = create_equal_even_odd(n)
  |eeo:> = H(n)*|0:>_n;
  count = 1;
  while (count < n)
    gate_spec = "c" + count + "x" + (count + 1);
    |eeo:> =* cu_gate(sigma_z(1), gate_spec, n);
    count += 2;
  end

