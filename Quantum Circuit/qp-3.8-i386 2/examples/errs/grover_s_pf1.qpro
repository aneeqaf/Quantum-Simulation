# Author: George F. Viamontes
#
# This program implements Grover's quantum search algorithm for 2
# logical data qubits and 1 logical oracle qubit.  Each logical qubit
# is encoded with the CSS 7-qubit code.  3 additional ancilla qubits
# are used to help calculate the error syndrome at any given time.
# Thus, the maximum circuit size for this benchmark is 24 qubits.  The
# oracle marks the last element in the "database."  A phase-flip error
# on the third physical qubit of the logical oracle qubit is
# introduced, detected, and corrected.  The simulation model is the
# density matrix.

# Start gathering performance statistics
tic

logical_ckt_size = 3;

# Initialize a logical |0> (i.e. |0>L)
logic_0 = cb("0000000")*cb("0000000")';
# H can be used instead of hadamard in version 3.1 and higher.
tmp_op = kron(identity(4), hadamard(3));
logic_0 = tmp_op*logic_0*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x4c7", 7);
logic_0 = tmp_op*logic_0*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x2c7", 7);
logic_0 = tmp_op*logic_0*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x1c7", 7);
logic_0 = tmp_op*logic_0*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x4c6", 7);
logic_0 = tmp_op*logic_0*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x3c6", 7);
logic_0 = tmp_op*logic_0*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x1c6", 7);
logic_0 = tmp_op*logic_0*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x4c5", 7);
logic_0 = tmp_op*logic_0*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x3c5", 7);
logic_0 = tmp_op*logic_0*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x2c5", 7);
logic_0 = tmp_op*logic_0*tmp_op';

# Initialize a logical |1> (i.e. |1>L)
logic_1 = sigma_x(7)*logic_0*sigma_x(7)';

# Initialize the data qubits and the oracle qubit
density_state = kron(kron(logic_0, logic_0), logic_1);

# Introduce a phase-flip error on the oracle qubit
phase_flip = cu_gate(sigma_z(1), "x17", 21);
density_state = phase_flip*density_state*phase_flip';

# Shift the basis of the qubits to detect phase flip errors as bit
# flip errors
density_state = hadamard(21)*density_state*hadamard(21)';

# Check the error syndrome of the oracle qubit
syn_state = cb("000")*cb("000")';
density_state = kron(density_state, syn_state);

# Calculate syndrome qubit 1
tmp_op = cu_gate(sigma_x(1), "c18x22", 24);
density_state = tmp_op*density_state*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c19x22", 24);
density_state = tmp_op*density_state*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c20x22", 24);
density_state = tmp_op*density_state*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c21x22", 24);
density_state = tmp_op*density_state*tmp_op';

# Calculate syndrome qubit 2
tmp_op = cu_gate(sigma_x(1), "c16x23", 24);
density_state = tmp_op*density_state*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c17x23", 24);
density_state = tmp_op*density_state*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c20x23", 24);
density_state = tmp_op*density_state*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c21x23", 24);
density_state = tmp_op*density_state*tmp_op';

# Calculate syndrome qubit 3
tmp_op = cu_gate(sigma_x(1), "c15x24", 24);
density_state = tmp_op*density_state*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c17x24", 24);
density_state = tmp_op*density_state*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c19x24", 24);
density_state = tmp_op*density_state*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c21x24", 24);
density_state = tmp_op*density_state*tmp_op';

# Measure the syndrome qubits to determine if an error occurred
syn1_value = pmeasure(22, density_state);
syn2_value = pmeasure(23, density_state);
syn3_value = pmeasure(24, density_state);

# Generate the error correcting gates which use the syndrome qubits

# Gate to fix physical qubit 1 of logical qubit a
fix_a1 = cu_gate(sigma_x(1), "x15n22n23c24", 24);

# Gate to fix physical qubit 2 of logical qubit a
fix_a2 = cu_gate(sigma_x(1), "x16n22c23n24", 24);

# Gate to fix physical qubit 3 of logical qubit a
fix_a3 = cu_gate(sigma_x(1), "x17n22c23c24", 24);

# Gate to fix physical qubit 4 of logical qubit a
fix_a4 = cu_gate(sigma_x(1), "x18c22n23n24", 24);

# Gate to fix physical qubit 5 of logical qubit a
fix_a5 = cu_gate(sigma_x(1), "x19c22n23c24", 24);

# Gate to fix physical qubit 6 of logical qubit a
fix_a6 = cu_gate(sigma_x(1), "x20c22c23n24", 24);

# Gate to fix physical qubit 7 of logical qubit a
fix_a7 = cu_gate(sigma_x(1), "x21c22c23c24", 24);

if ((syn1_value == 0) && (syn2_value == 0) && (syn3_value == 0))
  echo("No phase flip error occurred on the logical oracle qubit")
else
  echo("Phase-flip error occurred on the following physical qubit")
  echo("of the logical oracle qubit");
  bad_qubit = syn3_value + 2*syn2_value + 4*syn1_value

  # Correct the error
  density_state = fix_a1*density_state*fix_a1';
  density_state = fix_a2*density_state*fix_a2';
  density_state = fix_a3*density_state*fix_a3';
  density_state = fix_a4*density_state*fix_a4';
  density_state = fix_a5*density_state*fix_a5';
  density_state = fix_a6*density_state*fix_a6';
  density_state = fix_a7*density_state*fix_a7';

  echo("Error corrected.")
end

density_state = ptrace(22, density_state);
density_state = ptrace(22, density_state);
density_state = ptrace(22, density_state);

# Put the qubits back into the computational basis
density_state = hadamard(21)*density_state*hadamard(21)';

# Put the logical qubits into an equal superposition by applying
# Hadamards to all physical qubits
density_state = hadamard(21)*density_state*hadamard(21)';

# Set-up the number of Grover iterations. Ref: Boyer et
# al. quant-ph/9605034
N = 2^(logical_ckt_size - 1);
M = 1;
x = sqrt(M/N);
# Use the fact that asin(x) = atan(x/sqrt(1 - x^2)) for -1 < x < 1
theta = atan(x/sqrt(1 - x^2));
echo("Number of Grover iterations needed to measure with optimal probability:")
grov_iters = pi/4/theta

echo("Computing the Grover iterations may take some time...")
# Perform the Grover iterations
grov_count = 1;

while (grov_count <= grov_iters)
  # Transversely apply the oracle
  oracle = cu_gate(sigma_x(1), "c1c8x15", 21);
  density_state = oracle*density_state*oracle';
  oracle = cu_gate(sigma_x(1), "c2c9x16", 21);
  density_state = oracle*density_state*oracle';
  oracle = cu_gate(sigma_x(1), "c3c10x17", 21);
  density_state = oracle*density_state*oracle';
  oracle = cu_gate(sigma_x(1), "c4c11x18", 21);
  density_state = oracle*density_state*oracle';
  oracle = cu_gate(sigma_x(1), "c5c12x19", 21);
  density_state = oracle*density_state*oracle';
  oracle = cu_gate(sigma_x(1), "c6c13x20", 21);
  density_state = oracle*density_state*oracle';
  oracle = cu_gate(sigma_x(1), "c7c14x21", 21);
  density_state = oracle*density_state*oracle';

  # Optional performance/debugging output
  # echo("oracle applied")
  # toc
  
  # Apply Hadamards to the data qubits
  h_data = kron(hadamard(14), identity(7));
  density_state = h_data*density_state*h_data';
  
  # echo("Hadamards applied")
  # toc

  # Apply the Conditional Phase Shift in 5 pieces as per the
  # decomposition shown in Nielsen & Chuang p. 256
  
  # Piece 1 of 5
  cps_1 = kron(sigma_x(14), identity(7));
  density_state = cps_1*density_state*cps_1';

  # echo("CPS piece 1 of 5 applied")
  # toc

  # Piece 2 of 5
  cps_2 = kron(kron(identity(7), hadamard(7)), identity(7));
  density_state = cps_2*density_state*cps_2';

  # echo("CPS piece 2 of 5 applied")
  # toc

  # Piece 3 of 5
  cps_3 = cu_gate(sigma_x(1), "c1x8", 21);
  density_state = cps_3*density_state*cps_3';
  cps_3 = cu_gate(sigma_x(1), "c2x9", 21);
  density_state = cps_3*density_state*cps_3';
  cps_3 = cu_gate(sigma_x(1), "c3x10", 21);
  density_state = cps_3*density_state*cps_3';
  cps_3 = cu_gate(sigma_x(1), "c4x11", 21);
  density_state = cps_3*density_state*cps_3';
  cps_3 = cu_gate(sigma_x(1), "c5x12", 21);
  density_state = cps_3*density_state*cps_3';
  cps_3 = cu_gate(sigma_x(1), "c6x13", 21);
  density_state = cps_3*density_state*cps_3';
  cps_3 = cu_gate(sigma_x(1), "c7x14", 21);
  density_state = cps_3*density_state*cps_3';

  # echo("CPS piece 3 of 5 applied")
  # toc

  # Piece 4 of 5 is actually piece 2 repeated again
  density_state = cps_2*density_state*cps_2';
  
  # echo("CPS piece 4 of 5 applied")
  # toc

  # Piece 5 of 5 is actually piece 1 repeated again
  density_state = cps_1*density_state*cps_1';

  # echo("CPS piece 5 of 5 applied")
  # toc

  # Apply Hadamards to the data qubits
  density_state = h_data*density_state*h_data';

  # echo("2nd set of Hadamards applied")
  # toc
  
  grov_count = grov_count + 1
end

# Apply Hadamards to the logical oracle qubit
h_oracle = kron(identity(14), hadamard(7));
density_state = h_oracle*density_state*h_oracle';

echo("Grover iterations complete!")
toc

# To determine the outcome of the circuit, we can just use ancilla
# qubits to check the parity of the logical data qubits.  The desired
# result on the logical data qubits is 11, so if the parity for both
# logical data qubits is 1, then the circuit performed correctly

# Check parity on the first logical qubit
density_state = kron(density_state, cb("0")*cb("0")');
parity_op = cu_gate(sigma_x(1), "c1x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c2x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c3x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c4x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c5x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c6x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c7x22", 22);
density_state = parity_op*density_state*parity_op';

parity_data1 = pmeasure(22, density_state);

# Check parity on the first logical qubit
density_state = ptrace(22, density_state);
density_state = kron(density_state, cb("0")*cb("0")');
parity_op = cu_gate(sigma_x(1), "c8x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c9x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c10x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c11x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c12x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c13x22", 22);
density_state = parity_op*density_state*parity_op';
parity_op = cu_gate(sigma_x(1), "c14x22", 22);
density_state = parity_op*density_state*parity_op';

parity_data2 = pmeasure(22, density_state);

# The database element retrieved by the oracle should be element
# number 3, which the parity bits encode in binary (element numbering
# starts at 0)
echo("The algorithm retrieved element #:")
2*parity_data1 + parity_data2

toc
