# Author: George F. Viamontes
#
# This simulation encodes a single qubit in the state 0.866025|0> +
# 0.5|1> using the 7-qubit CSS code.  A bit-flip error on the third
# physical qubit is introduced and detected.

tic
# Initialize a qubit with the CSS code

q_css_0 = 0.866025*cb("0000000")*cb("0000000")';
q_css_1 = 0.5*cb("0000001")*cb("0000001")';
q_css = q_css_0 + q_css_1;
# H can be used instead of hadamard in version 3.1 and higher.
tmp_op = kron(identity(4), hadamard(3)); 
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x4c7", 7);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x2c7", 7);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x1c7", 7);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x4c6", 7);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x3c6", 7);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x1c6", 7);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x4c5", 7);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x3c5", 7);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "x2c5", 7);
q_css = tmp_op*q_css*tmp_op';

# Introduce an error
tmp_op = cu_gate(sigma_x(1), "x3", 7);
q_css = tmp_op*q_css*tmp_op';

# Calculate the syndrome
s0_2 = cb("000")*cb("000")';
q_css = kron(q_css, s0_2);

tmp_op = cu_gate(sigma_x(1), "c4x8", 10);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c5x8", 10);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c6x8", 10);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c7x8", 10);
q_css = tmp_op*q_css*tmp_op';

tmp_op = cu_gate(sigma_x(1), "c2x9", 10);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c3x9", 10);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c6x9", 10);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c7x9", 10);
q_css = tmp_op*q_css*tmp_op';

tmp_op = cu_gate(sigma_x(1), "c1x10", 10);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c3x10", 10);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c5x10", 10);
q_css = tmp_op*q_css*tmp_op';
tmp_op = cu_gate(sigma_x(1), "c7x10", 10);
q_css = tmp_op*q_css*tmp_op';

# Measure the syndrome ancilla qubits and determine if an error occurred
s0_value = pmeasure(8, q_css);
s1_value = pmeasure(9, q_css);
s2_value = pmeasure(10, q_css);

if ((s0_value == 0) && (s1_value == 0) && (s2_value == 0))
  echo("No error occurred!");
else
  echo("Error occurred on the following qubit");
  s2_value + 2*s1_value + 4*s0_value
end
toc
