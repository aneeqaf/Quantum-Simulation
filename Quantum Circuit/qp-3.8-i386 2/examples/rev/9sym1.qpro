# Author: Dmitri Maslov
# Converted by: George F. Viamontes
#
# A reversible logic circuit which outputs a |1> on the final qubit if
# the number of |1>'s in the input qubits is 3, 4, 5, or 6.  The
# functionality of this circuit comes from "Reversible Logic Synthesis
# Benchmarks Page" (http://www.cs.uvic.ca/~dmaslov/)

tic

# Initialze the state to contain 3 ones
density_state = cb("100100010000")*cb("100100010000")';

op = cu_gate(sigma_x(1), "cciiiiiiixii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "cxiiiiiiiiii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiciiiiiicxi");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "icciiiiiixii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "icxiiiiiiiii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiciiiiiicx");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiciiiiicxi");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iicciiiiixii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iicxiiiiiiii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiciiiiicx");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiciiiicxi");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiicciiiixii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiicxiiiiiii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiciiiicx");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiciiicxi");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiicciiixii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiicxiiiiii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiiciiicx");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiiciicxi");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiicciixii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiicxiiiii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiiiciicx");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiiicicxi");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiiccixii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiicxiiii");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiiiicicx");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiiiicicx");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiiiiccxi");
density_state = op*density_state*op';

op = cu_gate(sigma_x(1), "iiiiiiiiiicx");
density_state = op*density_state*op';

# Measure the outcome
output = pmeasure(12, density_state);

echo("The output of 9sym for inputs 100100010000 is:")
output

toc
