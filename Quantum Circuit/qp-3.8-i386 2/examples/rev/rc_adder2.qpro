# Author: George F. Viamontes
#
# Reversible 16-qubit ripple carry adder which can perform the
# addition of 4-bit numbers.  This circuit computes 2 + 11.

tic

# Initialize the qubit states to add 0010 + 1011 (a.k.a 2 + 11)
density_state = cb("0100110000000100")*cb("0100110000000100")';

# Create the full-adder
fa = cu_gate(sigma_x(1), "icxi")*cu_gate(sigma_x(1), "iccx")*cu_gate(sigma_x(1), "cxii")*cu_gate(sigma_x(1), "ccix");

# Add the first pair of qubits
fa_op = kron(fa, identity(12));
density_state = fa_op*density_state*fa_op';

# Carry over the carry bit
carry_op = cu_gate(sigma_x(1), "c4x7", 16);
density_state = carry_op*density_state*carry_op';

# Add the second pair of qubits
fa_op = kron(kron(identity(4), fa), identity(8));
density_state = fa_op*density_state*fa_op';

# Carry over the carry bit
carry_op = cu_gate(sigma_x(1), "c8x11", 16);
density_state = carry_op*density_state*carry_op';

# Add the third pair of qubits
fa_op = kron(kron(identity(8), fa), identity(4));
density_state = fa_op*density_state*fa_op';

# Carry over the carry bit
carry_op = cu_gate(sigma_x(1), "c12x15", 16);
density_state = carry_op*density_state*carry_op';

# Add the fourth pair of qubits
fa_op = kron(identity(12), fa);
density_state = fa_op*density_state*fa_op';

# Measure the four result qubits and the last carry qubit 
# and output their combined value in decimal
res0 = pmeasure(3, density_state);
res1 = pmeasure(7, density_state);
res2 = pmeasure(11, density_state);
res3 = pmeasure(15, density_state);
r3 = pmeasure(16, density_state);

echo("The result of 2 + 11 is:")
result = 16*r3 + 8*res3 + 4*res2 + 2*res1 + res0

toc