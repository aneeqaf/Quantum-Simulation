# Author: Christos Koufogiannakis
#
# Performs the AND of 20 qubits in an equal superposition and stores
# the result in an ancilla qubit.  With QuIDDPro, this simulation should 
# run almost instantaneously on most computers.  The correct output is:
# 0.999999
# 9.53674e-07
#
# QuIDDPro apparently gives more accurate results than Oemer's qcl for
# this simulation.

X = [0 1; 1 0];
and20 = cu_gate(X, "ccccccccccccccccccccx");
state = cb("000000000000000000000");
state = and20*kron(hadamard(20), identity(1))*state;  # H can be used instead
                                      # of hadamard in version 3.1 and higher
measure_sv0(21, state)
measure_sv1(21, state)
