function new_state = apply_qft(state, n, ckt_size)
  new_state = state;

  # Apply Hadamard and controlled-R_k gates to each qubit.
  curr_qubit = 1;
  while (curr_qubit <= n)
    # Apply a Hadamard gate.
    new_state =* cu_gate(H(1), "x" + curr_qubit, ckt_size);

    target = curr_qubit;
    control = n;
    while ((control > target) && (target > 0))
      # Apply controlled-R_k gates to each qubit.
      r_k = [1 0; 0 exp(-2*pi*i/(2^(control - target + 1)))];
      new_state =* cu_gate(r_k, "c" + control + "x" + target, ckt_size);
      control--;
    end

    curr_qubit++;
  end

  # Apply swap gates to reverse the order of all qubits.
  curr_swap = 0;
  while (n/2 - curr_swap >= 1)
    new_state = swap(curr_swap + 1, n - curr_swap, new_state);
    curr_swap++;
  end
